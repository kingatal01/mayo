generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum StatSection {
  HERO
  ABOUT
}

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(ADMIN)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

model HeroSlide {
  id          Int      @id @default(autoincrement())
  tag         String
  title       String
  description String   @db.Text
  ctaLabel    String   @default("En savoir plus")
  ctaHref     String   @default("#about")
  image       String   @default("/image_face.jpeg")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("hero_slides")
}

model Stat {
  id        Int         @id @default(autoincrement())
  section   StatSection
  value     String
  label     String
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("stats")
}

model Specialty {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  description String   @db.Text
  icon        String?  @db.LongText
  color       String   @default("bg-sky-50 text-sky-500 group-hover:bg-sky-500 group-hover:text-white")
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("specialties")
}

model Doctor {
  id        Int      @id @default(autoincrement())
  name      String
  specialty String
  initials  String
  photo     String?
  color     String   @default("from-blue-400 to-blue-600")
  facebook  String?
  twitter   String?
  linkedin  String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("doctors")
}

model BlogPost {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  category    String
  excerpt     String    @db.Text
  content     String?   @db.LongText
  color       String    @default("from-blue-400 to-blue-600")
  readTime    String    @default("5 min de lecture")
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("blog_posts")
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  text      String   @db.Text
  initials  String
  color     String   @default("bg-blue-500")
  rating    Int      @default(5)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String   @db.Text
  answer    String   @db.Text
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model Appointment {
  id        Int               @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  specialty String
  date      DateTime          @db.Date
  message   String?           @db.Text
  status    AppointmentStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("appointments")
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscribers")
}

model Setting {
  key       String   @id @db.VarChar(191)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("settings")
}
